{
  "name": "legi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:emu": "NEXT_PUBLIC_USE_EMULATORS=1 next dev",
    "emu": "npm run rules -- --emu && firebase emulators:start --only auth,firestore --project demo-legi --import=.emulator-data --export-on-exit=.emulator-data",
    "build": "next build",
    "lint": "eslint",
    "test": "TZ=Asia/Ho_Chi_Minh node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/register.mjs --test test/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "rules": "node scripts/rules.mjs",
    "seed": "node scripts/seed-emu.mjs"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "sharp": "^0.34.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
